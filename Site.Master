<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.master.vb" Inherits="MultiTool.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        .current-link {
            font-weight: 700;         
            color: #0d6efd !important; 
            text-decoration: underline; 
        }

        /* Bright pink ad panels for testing */
        .ad-panel {
            background-color: #ff69b4 !important; /* hot pink */
            color: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 5px;
            text-align: center;
            font-weight: bold;
        }
        #adPanelBottom {
    margin-bottom: 0 !important;
}
footer {
    margin-top: 0 !important;
}

    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <form runat="server" class="flex-grow-1 d-flex flex-column">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

          <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" href="../../default.aspx">Home</a>
                    <a class="navbar-brand fw-bold text-primary" href="../../portfolio.aspx">Portfolio/Projects</a>
                <a class="navbar-brand fw-bold text-primary" href="../../Login.aspx">Login</a>
            </div>
        </nav>
        
        <!-- Top Ad Panel -->
        <asp:Panel ID="adPanelTop" runat="server" CssClass="ad-panel mb-3" Visible="True">
            TOP AD PANEL - Placeholder
        </asp:Panel>

        <!-- Main Content -->
        <%--<main class="flex-grow-1 my-4 container">--%>
      <%--  <main class="flex-grow-1 my-4 container-xl">--%>
          <main class="flex-grow-1 my-4 container-fluid">

            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>



<%--        <!-- Middle Ad Panel -->
        <asp:Panel ID="adPanelMiddle" runat="server" CssClass="ad-panel my-3" Visible="True">
            MIDDLE AD PANEL - Placeholder
        </asp:Panel>--%>

 

     <!-- Bottom Ad Panel -->
<asp:Panel ID="adPanelBottom" runat="server" CssClass="ad-panel m-0" Visible="True">
    BOTTOM AD PANEL - Placeholder
</asp:Panel>

<!-- Footer -->
<footer class="bg-dark text-white py-4 text-center">
    &copy; <%= DateTime.Now.Year %> Calculator Suite. All rights reserved.
</footer>


    </form>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
